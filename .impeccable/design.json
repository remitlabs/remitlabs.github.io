  "narrative": {
    "northStar": "Remit instrument",
    "overview": "Remit uses charcoal surfaces, Archivo interface type and amber actions. Short introductions lead to visual evidence, with supporting detail available in disclosures. IBM Plex Mono identifies commands and measured values. Newsreader remains the article reading face.",
    "keyCharacteristics": [
      "One continuous reading path.",
      "Wide tutorial and mesh, bounded prose.",
      "Shared navigation, controls and disclosure styles."
    ],
    "rules": [
      {
        "name": "The accent rule",
        "body": "Use amber for actions and selected states. Use green and red for reported data states.",
        "section": "colors"
      },
      {
        "name": "The reading order rule",
        "body": "Give each section one heading and one reading path. Place supporting explanations in native disclosures when the reader can choose to expand them.",
        "section": "layout"
      },
      {
        "name": "R-01",
        "body": "The latest user-approved tutorial-first, single-column direction supersedes the older split hero and numbered section rails. Merge that layout decision into the established Archivo, charcoal and amber identity.",
        "section": "layout"
      },
      {
        "name": "R-02",
        "body": "Headline, command and traction share the opening viewport. The tutorial starts on scrolling into view.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do place the homepage tutorial before the mesh and risk graph.",
      "Do keep the mesh caption, textual counts and report limits beside the visual evidence.",
      "Do reuse the shared Archivo controls, amber focus treatment and hairline dividers.",
      "Do keep command text and tables usable at narrow widths."
    ],
    "donts": []
  }
}
